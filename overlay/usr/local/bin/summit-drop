#!/usr/bin/python3
"""Summit Drop: send files between this computer and any Mac, iPhone or iPad on the same Wi-Fi.

Nothing to install on the Apple device: it scans the code (or types the address) and gets a page in Safari
where it can send photos and files here, and pick up whatever this computer is offering.

  - Runs only while this window is open; closing the window stops sharing.
  - Every session has a new 6-digit code. Without it a device on the network can neither send nor fetch.
  - Files received go to ~/Downloads (names are never trusted: no folders, no overwriting).

  summit-drop [FILE ...]        open the window, offering FILEs to the other device
  summit-drop --serve-only      (testing) run the server without a window; prints the address and code
"""
import html, http.server, json, os, re, secrets, socket, socketserver, subprocess, sys, threading, time, urllib.parse

HOME = os.path.expanduser("~")
PORT = 8765
MAX_UPLOAD = 20 * 1024 ** 3


def downloads():
    try:
        d = subprocess.run(["xdg-user-dir", "DOWNLOAD"], capture_output=True, text=True, timeout=5).stdout.strip()
    except Exception:
        d = ""
    d = d if d and d != HOME else os.path.join(HOME, "Downloads")
    os.makedirs(d, exist_ok=True)
    return d


def lan_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.0.2.1", 9)); return s.getsockname()[0]       # no packet is sent; this only picks the route
    except OSError:
        return "127.0.0.1"
    finally:
        s.close()


def safe_name(name):
    name = os.path.basename(name.replace("\\", "/")).strip().lstrip(".")
    name = re.sub(r"[\x00-\x1f/]", "_", name)[:180]
    return name or "file"


def unique_path(folder, name):
    base, ext = os.path.splitext(name); path = os.path.join(folder, name); n = 2
    while os.path.exists(path):
        path = os.path.join(folder, f"{base} {n}{ext}"); n += 1
    return path


def human(n):
    for unit in ("bytes", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB": return f"{n:.0f} {unit}" if unit in ("bytes", "KB") else f"{n:.1f} {unit}"
        n /= 1000


PAGE = """<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Summit Drop</title>
<style>
:root { color-scheme: light dark; --bg:#f5f5f7; --card:#fff; --fg:#1d1d1f; --sub:#6e6e73; --line:rgba(0,0,0,.1); --accent:#0a6cff; }
@media (prefers-color-scheme: dark) { :root { --bg:#000; --card:#1c1c1e; --fg:#f5f5f7; --sub:#98989d; --line:rgba(255,255,255,.14); --accent:#3b8cff; } }
* { box-sizing: border-box; } body { margin:0; background:var(--bg); color:var(--fg); font: 17px -apple-system, "SF Pro Text", "Helvetica Neue", sans-serif; }
main { max-width: 560px; margin: 0 auto; padding: 28px 16px 60px; }
h1 { font-size: 28px; font-weight: 700; margin: 8px 0 2px; } .sub { color: var(--sub); margin: 0 0 22px; }
.card { background: var(--card); border-radius: 18px; padding: 18px; margin-bottom: 16px; }
h2 { font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--sub); margin: 0 0 12px; font-weight: 600; }
.btn { display:block; width:100%; border:0; border-radius: 12px; background: var(--accent); color:#fff; font: inherit; font-weight: 600; padding: 14px; text-align:center; cursor:pointer; }
.btn[disabled] { opacity:.5; } input[type=file] { display:none; }
.row { display:flex; align-items:center; gap:12px; padding: 12px 0; border-top: 1px solid var(--line); } .row:first-of-type { border-top:0; padding-top:0; }
.row a { color: var(--accent); text-decoration:none; font-weight:600; white-space:nowrap; } .name { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.size { color: var(--sub); font-size: 14px; white-space:nowrap; } .empty { color: var(--sub); margin:0; }
progress { width:100%; height: 8px; margin-top: 14px; display:none; } #status { color: var(--sub); font-size: 15px; margin: 10px 0 0; min-height: 20px; }
input[type=tel] { width:100%; font: 600 28px ui-monospace, Menlo, monospace; letter-spacing:.3em; text-align:center; padding: 12px; border-radius: 12px; border: 1px solid var(--line); background: var(--bg); color: var(--fg); margin-bottom: 12px; }
</style></head><body><main>
<h1>Summit Drop</h1><p class="sub">Connected to __HOST__</p>
__BODY__
</main>__SCRIPT__</body></html>"""

LOGIN = """<form class="card" method="get" action="/"><h2>Enter the code</h2>
<input type="tel" name="k" inputmode="numeric" pattern="[0-9]*" maxlength="6" autofocus placeholder="000000" aria-label="Six-digit code shown on the computer">
<button class="btn">Connect</button>__ERR__</form>"""

MAIN = """<div class="card"><h2>Send to __HOST__</h2>
<label class="btn" for="f" id="pick">Choose Photos or Files</label><input id="f" type="file" multiple>
<progress id="bar" max="100" value="0"></progress><p id="status" role="status"></p></div>
<div class="card"><h2>From __HOST__</h2><div id="list">__LIST__</div></div>"""

SCRIPT = """<script>
const f = document.getElementById('f'), bar = document.getElementById('bar'), st = document.getElementById('status'), pick = document.getElementById('pick');
f.addEventListener('change', async () => {
  const files = [...f.files]; if (!files.length) return;
  bar.style.display = 'block'; let done = 0, failed = 0;
  for (const file of files) {
    st.textContent = 'Sending ' + file.name + '…';
    try {
      await new Promise((ok, bad) => {
        const x = new XMLHttpRequest(); x.open('POST', '/upload?name=' + encodeURIComponent(file.name));
        x.upload.onprogress = e => { if (e.lengthComputable) bar.value = (done + e.loaded / e.total) / files.length * 100; };
        x.onload = () => x.status == 200 ? ok() : bad(); x.onerror = bad; x.send(file);
      });
    } catch (e) { failed++; }
    done++; bar.value = done / files.length * 100;
  }
  st.textContent = failed ? (failed + ' of ' + files.length + ' could not be sent. Try again.') : (files.length == 1 ? 'Sent.' : files.length + ' files sent.');
  f.value = '';
});
async function refresh() {
  try { const r = await fetch('/list'); if (r.ok) document.getElementById('list').innerHTML = await r.text(); } catch (e) {}
}
setInterval(refresh, 4000);
</script>"""


class State:
    def __init__(self):
        self.code = f"{secrets.randbelow(10 ** 6):06d}"
        t = os.environ.get("SUMMIT_DROP_TEST_CODE", "")              # for automated tests only
        if re.fullmatch(r"\d{6}", t): self.code = t
        self.cookie = secrets.token_urlsafe(24)
        self.offers = {}            # id -> path
        self.lock = threading.Lock()
        self.on_received = lambda path, size: None
        self.on_fetched = lambda path: None
        self.fails = {}             # address -> (count, time): slows down guessing the code
        self.host = socket.gethostname()

    def offer(self, path):
        if not os.path.isfile(path): return
        with self.lock:
            if path not in self.offers.values(): self.offers[secrets.token_urlsafe(8)] = path

    def withdraw(self, path):
        with self.lock:
            for k in [k for k, v in self.offers.items() if v == path]: del self.offers[k]

    def list_html(self):
        with self.lock: items = list(self.offers.items())
        rows = []
        for key, path in items:
            try: size = human(os.path.getsize(path))
            except OSError: continue
            rows.append(f'<div class="row"><span class="name">{html.escape(os.path.basename(path))}</span>'
                        f'<span class="size">{size}</span><a href="/get/{key}" download>Download</a></div>')
        return "".join(rows) or '<p class="empty">Nothing is being offered right now. Files chosen on the computer appear here.</p>'


def make_handler(state):
    class Handler(http.server.BaseHTTPRequestHandler):
        protocol_version = "HTTP/1.1"
        server_version = "SummitDrop"; sys_version = ""

        def log_message(self, *a): pass

        def authed(self):
            for part in (self.headers.get("Cookie") or "").split(";"):
                k, _, v = part.strip().partition("=")
                if k == "sd" and secrets.compare_digest(v, state.cookie): return True
            return False

        def blocked(self):
            n, t = state.fails.get(self.client_address[0], (0, 0))
            return n >= 8 and time.time() - t < 300

        def send(self, code, body, ctype="text/html; charset=utf-8", headers=()):
            data = body.encode() if isinstance(body, str) else body
            self.send_response(code)
            self.send_header("Content-Type", ctype); self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store"); self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Security-Policy", "default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; frame-ancestors 'none'")
            for k, v in headers: self.send_header(k, v)
            self.end_headers(); self.wfile.write(data)

        def page(self, body, script="", code=200, headers=()):
            host = html.escape(state.host)
            self.send(code, PAGE.replace("__BODY__", body).replace("__SCRIPT__", script).replace("__HOST__", host), headers=headers)

        def do_GET(self):
            url = urllib.parse.urlsplit(self.path); q = urllib.parse.parse_qs(url.query)
            if url.path == "/":
                k = (q.get("k") or [""])[0]
                if k:
                    if self.blocked(): return self.page(LOGIN.replace("__ERR__", '<p id="status">Too many tries. Wait a few minutes.</p>'), code=429)
                    if secrets.compare_digest(k, state.code):
                        state.fails.pop(self.client_address[0], None)
                        self.send_response(303); self.send_header("Location", "/"); self.send_header("Content-Length", "0")
                        self.send_header("Set-Cookie", f"sd={state.cookie}; HttpOnly; SameSite=Strict; Path=/"); self.end_headers(); return
                    n, _ = state.fails.get(self.client_address[0], (0, 0)); state.fails[self.client_address[0]] = (n + 1, time.time())
                    return self.page(LOGIN.replace("__ERR__", '<p id="status">That code is not right. Check the computer\'s screen.</p>'), code=403)
                if not self.authed(): return self.page(LOGIN.replace("__ERR__", ""))
                return self.page(MAIN.replace("__LIST__", state.list_html()), SCRIPT)
            if not self.authed(): return self.send(403, "Enter the code first.", "text/plain; charset=utf-8")
            if url.path == "/list": return self.send(200, state.list_html())
            if url.path.startswith("/get/"):
                with state.lock: path = state.offers.get(url.path[5:])
                if not path or not os.path.isfile(path): return self.send(404, "Not available any more.", "text/plain; charset=utf-8")
                try:
                    size = os.path.getsize(path); f = open(path, "rb")
                except OSError:
                    return self.send(404, "Not available any more.", "text/plain; charset=utf-8")
                with f:
                    self.send_response(200)
                    self.send_header("Content-Type", "application/octet-stream"); self.send_header("Content-Length", str(size))
                    name = urllib.parse.quote(os.path.basename(path))
                    self.send_header("Content-Disposition", f"attachment; filename*=UTF-8''{name}"); self.end_headers()
                    try:
                        while True:
                            chunk = f.read(256 * 1024)
                            if not chunk: break
                            self.wfile.write(chunk)
                    except OSError:
                        return
                state.on_fetched(path); return
            self.send(404, "Not found.", "text/plain; charset=utf-8")

        def do_POST(self):
            url = urllib.parse.urlsplit(self.path); q = urllib.parse.parse_qs(url.query)
            if url.path != "/upload" or not self.authed():
                self.close_connection = True; return self.send(403, "Enter the code first.", "text/plain; charset=utf-8")
            try: length = int(self.headers.get("Content-Length") or -1)
            except ValueError: length = -1
            if length < 0 or length > MAX_UPLOAD:
                self.close_connection = True; return self.send(413, "Too large.", "text/plain; charset=utf-8")
            folder = downloads(); name = safe_name((q.get("name") or ["file"])[0])
            st = os.statvfs(folder)
            if st.f_bavail * st.f_frsize < length + 200 * 1024 ** 2:
                self.close_connection = True; return self.send(507, "Not enough space.", "text/plain; charset=utf-8")
            part = os.path.join(folder, f".{secrets.token_hex(6)}.summitdrop")
            left = length
            try:
                with open(part, "wb") as out:
                    while left:
                        chunk = self.rfile.read(min(left, 256 * 1024))
                        if not chunk: raise OSError("connection closed")
                        out.write(chunk); left -= len(chunk)
                final = unique_path(folder, name); os.replace(part, final)
            except OSError:
                try: os.remove(part)
                except OSError: pass
                self.close_connection = True; return self.send(500, "Could not save.", "text/plain; charset=utf-8")
            state.on_received(final, length)
            self.send(200, "ok", "text/plain; charset=utf-8")
    return Handler


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True; allow_reuse_address = True


def start_server(state):
    last = None
    for port in range(PORT, PORT + 10):
        try:
            srv = Server(("0.0.0.0", port), make_handler(state)); break
        except OSError as e:
            last = e
    else:
        raise last
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    return srv


def qr_png(text, path):
    try:
        return subprocess.run(["qrencode", "-o", path, "-s", "8", "-m", "2", "-l", "M", text], capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


# ------------------------------------------------------------------ window
def gui(files):
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib, Gio, GdkPixbuf, Pango
    GLib.set_prgname("summit-drop"); Gdk.set_program_class("Summit-drop")

    state = State()
    for f in files: state.offer(os.path.abspath(f))
    try:
        srv = start_server(state)
    except OSError as e:
        d = Gtk.MessageDialog(message_type=Gtk.MessageType.ERROR, buttons=Gtk.ButtonsType.OK, text="Summit Drop couldn't start")
        d.format_secondary_text(str(e)); d.run(); return 1
    port = srv.server_address[1]; ip = lan_ip()
    url = f"http://{ip}:{port}"; nice = f"{state.host}.local:{port}"
    publish = None
    try:
        publish = subprocess.Popen(["avahi-publish", "-s", f"Summit Drop on {state.host}", "_http._tcp", str(port)],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass

    win = Gtk.Window(title="Summit Drop"); win.set_default_size(760, 540)
    win.set_icon_name("summit-drop")
    css = Gtk.CssProvider(); css.load_from_data(b"""
      .drop-title { font-size: 20pt; font-weight: 700; } .drop-code { font-size: 26pt; font-weight: 700; font-family: "JetBrains Mono", monospace; letter-spacing: 4px; }
      .drop-sub { opacity: 0.65; } .drop-zone { border: 2px dashed alpha(currentColor, 0.25); border-radius: 16px; padding: 18px; }
      .drop-zone.over { border-color: @theme_selected_bg_color; background-color: alpha(@theme_selected_bg_color, 0.10); }
      .drop-qr { background-color: #ffffff; border-radius: 14px; padding: 8px; }
    """)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def lab(text, cls=None, **kw):
        l = Gtk.Label(label=text, xalign=kw.pop("xalign", 0), wrap=True, **kw)
        if cls: l.get_style_context().add_class(cls)
        return l

    root = Gtk.Box(spacing=28, margin=26); win.add(root)
    # left: how the other device connects
    left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10); left.set_size_request(250, -1); root.pack_start(left, False, False, 0)
    left.pack_start(lab("Summit Drop", "drop-title"), False, False, 0)
    left.pack_start(lab("On your iPhone, iPad or Mac, on the same Wi-Fi:", "drop-sub"), False, False, 0)
    qr = os.path.join(GLib.get_user_runtime_dir() or "/tmp", f"summit-drop-{os.getpid()}.png")
    if qr_png(f"{url}/?k={state.code}", qr):
        try:
            img = Gtk.Image.new_from_pixbuf(GdkPixbuf.Pixbuf.new_from_file_at_scale(qr, 200, 200, True))
            frame = Gtk.Box(halign=Gtk.Align.START); frame.get_style_context().add_class("drop-qr"); frame.add(img)
            left.pack_start(frame, False, False, 4)
            left.pack_start(lab("Point the Camera at the code and tap the link. Or open Safari and go to:", "drop-sub"), False, False, 0)
        except GLib.Error:
            left.pack_start(lab("Open Safari and go to:", "drop-sub"), False, False, 0)
        try: os.remove(qr)
        except OSError: pass
    else:
        left.pack_start(lab("Open Safari and go to:", "drop-sub"), False, False, 0)
    addr = lab(f"{url}\n{nice}", selectable=True); addr.set_can_focus(False); left.pack_start(addr, False, False, 0)
    left.pack_start(lab("then enter this code:", "drop-sub"), False, False, 0)
    left.pack_start(lab(" ".join((state.code[:3], state.code[3:])), "drop-code"), False, False, 0)
    left.pack_end(lab("Sharing stops when you close this window.", "drop-sub"), False, False, 0)

    # right: what is offered, and what has arrived
    right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12); root.pack_start(right, True, True, 0)
    zone = Gtk.EventBox(); zone.get_style_context().add_class("drop-zone")
    zbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=14); zone.add(zbox)
    zbox.pack_start(lab("Send from this computer", xalign=0.5), False, False, 0)
    zbox.pack_start(lab("Drag files here, or choose them. They appear on the other device, ready to download.", "drop-sub", xalign=0.5, justify=Gtk.Justification.CENTER), False, False, 0)
    choose = Gtk.Button(label="Choose Files…", halign=Gtk.Align.CENTER); zbox.pack_start(choose, False, False, 0)
    right.pack_start(zone, False, False, 0)
    offered = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
    sc1 = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, min_content_height=90); sc1.add(offered)
    right.pack_start(sc1, True, True, 0)
    right.pack_start(lab("Received"), False, False, 0)
    received = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
    empty = lab("Files sent to this computer are saved in Downloads and listed here.", "drop-sub"); empty.show(); received.set_placeholder(empty)
    sc2 = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, min_content_height=110); sc2.add(received)
    right.pack_start(sc2, True, True, 0)

    def name_label(path):
        return Gtk.Label(label=os.path.basename(path), xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE, hexpand=True)

    def add_offer(path):
        path = os.path.abspath(path)
        if not os.path.isfile(path) or path in state.offers.values(): return
        state.offer(path)
        row = Gtk.Box(spacing=10, margin=6); row.pack_start(Gtk.Image.new_from_icon_name("text-x-generic", Gtk.IconSize.BUTTON), False, False, 0)
        row.pack_start(name_label(path), True, True, 0)
        status = lab("Waiting", "drop-sub"); row.pack_start(status, False, False, 0); row.status = status; row.path = path
        rm = Gtk.Button.new_from_icon_name("window-close-symbolic", Gtk.IconSize.BUTTON); rm.set_relief(Gtk.ReliefStyle.NONE); rm.set_tooltip_text("Stop offering this file")
        def remove(_b):
            state.withdraw(path); offered.remove(row.get_parent())
        rm.connect("clicked", remove); row.pack_start(rm, False, False, 0)
        offered.add(row); offered.show_all()

    def on_choose(_b):
        d = Gtk.FileChooserNative.new("Choose files to send", win, Gtk.FileChooserAction.OPEN, "Offer", "Cancel"); d.set_select_multiple(True)
        if d.run() == Gtk.ResponseType.ACCEPT:
            for f in d.get_filenames(): add_offer(f)
        d.destroy()
    choose.connect("clicked", on_choose)

    zone.drag_dest_set(Gtk.DestDefaults.ALL, [], Gdk.DragAction.COPY); zone.drag_dest_add_uri_targets()
    zone.connect("drag-motion", lambda *a: zone.get_style_context().add_class("over") or False)
    zone.connect("drag-leave", lambda *a: zone.get_style_context().remove_class("over"))
    def on_drop(_w, _ctx, _x, _y, data, _info, _t):
        for uri in data.get_uris():
            p = Gio.File.new_for_uri(uri).get_path()
            if p: add_offer(p)
    zone.connect("drag-data-received", on_drop)

    def got(path, size):
        row = Gtk.Box(spacing=10, margin=6); row.pack_start(Gtk.Image.new_from_icon_name("emblem-ok-symbolic", Gtk.IconSize.BUTTON), False, False, 0)
        row.pack_start(name_label(path), True, True, 0); row.pack_start(lab(human(size), "drop-sub"), False, False, 0)
        show = Gtk.Button(label="Show"); show.connect("clicked", lambda _b: subprocess.Popen(["thunar", os.path.dirname(path)]))
        row.pack_start(show, False, False, 0); received.insert(row, 0); received.show_all()
        try:
            subprocess.Popen(["notify-send", "-a", "Summit Drop", "-i", "summit-drop", "File received", f"{os.path.basename(path)} is in Downloads"])
        except OSError:
            pass
        return False
    def fetched(path):
        for r in offered.get_children():
            box = r.get_child()
            if getattr(box, "path", None) == path: box.status.set_text("Downloaded")
        return False
    state.on_received = lambda p, s: GLib.idle_add(got, p, s)
    state.on_fetched = lambda p: GLib.idle_add(fetched, p)
    for f in list(state.offers.values()):
        state.withdraw(f); add_offer(f)

    def quit_(*_):
        srv.shutdown()
        if publish: publish.terminate()
        Gtk.main_quit()
    win.connect("destroy", quit_); win.show_all(); Gtk.main()
    return 0


def main(argv):
    if "--serve-only" in argv:
        state = State(); srv = start_server(state)
        for f in argv[1:]:
            if not f.startswith("--"): state.offer(os.path.abspath(f))
        state.on_received = lambda p, s: print("received", p, s, flush=True)
        print(f"http://{lan_ip()}:{srv.server_address[1]} code {state.code}", flush=True)
        try:
            while True: time.sleep(3600)
        except KeyboardInterrupt:
            return 0
    return gui([a for a in argv[1:] if not a.startswith("--")])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
