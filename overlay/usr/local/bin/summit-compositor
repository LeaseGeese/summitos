#!/bin/sh
# Glass compositor: GPU (glx) with blur. If the GPU path fails (now or later), fall back to
# software compositing and remember it, so Summit makes glass more solid for readability.
CONF="$HOME/.config/summit/picom.conf"; FLAG="$HOME/.config/summit/no-gpu-blur"
LOG="$HOME/.cache/summit-picom.log"; mkdir -p "$HOME/.cache" "$HOME/.config/summit"
STATE="${XDG_RUNTIME_DIR:-/tmp}/summit-compositor-$(id -u)"; rm -f "$STATE"   # tells apps when compositing has settled
[ -f "$CONF" ] || summit-appearance write-files >/dev/null 2>&1
[ -f "$CONF" ] || CONF=/etc/xdg/picom-summit.conf
pkill -u "$(id -u)" -x picom 2>/dev/null; sleep 0.3

fallback() {
  echo software > "$STATE"
  if [ ! -f "$FLAG" ]; then touch "$FLAG"; (sleep 2; summit-appearance refresh-glass >/dev/null 2>&1) & fi
  # software mode: no blur, and square corners (rounding opaque windows in software paints the corners black)
  exec picom --config "$CONF" --backend xrender --no-vsync --blur-method none --corner-radius 0 2>>"$LOG"
}

[ -f "$FLAG.forced" ] && fallback           # user/admin can force software mode
picom --config "$CONF" 2>>"$LOG" &
PID=$!
sleep 4
kill -0 "$PID" 2>/dev/null || fallback       # GPU path failed to start
echo gpu > "$STATE"
if [ -f "$FLAG" ]; then rm -f "$FLAG"; (summit-appearance refresh-glass >/dev/null 2>&1) & fi
wait "$PID"; rc=$?
case "$rc" in 0|137|143) exit 0 ;; esac     # stopped on purpose (restart, logout)
fallback                                      # crashed later: switch to software mode
