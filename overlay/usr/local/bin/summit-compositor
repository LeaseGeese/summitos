#!/bin/sh
# Glass compositor, in order of preference:
#   1. picom 12 (shipped with Summit) on the GPU: glass blur and the window animations
#   2. Ubuntu's picom 10 on the GPU: the same glass, no animations
#   3. light software mode (no blur) for the rest of this boot
# A GPU mode only counts as working if it starts, actually draws the screen, and doesn't crash.
CFG="$HOME/.config/summit"; CONF="$CFG/picom.conf"; LEGACY="$CFG/picom-legacy.conf"; SOFT="$CFG/picom-soft.conf"
FLAG="$CFG/no-gpu-blur"; NO12="$CFG/no-picom12"
LOG="$HOME/.cache/summit-picom.log"; mkdir -p "$HOME/.cache" "$CFG"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}" XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}"   # the dock checks these
PICOM12=/usr/local/lib/summitos/picom
STATE="${XDG_RUNTIME_DIR:-/tmp}/summit-compositor-$(id -u)"; rm -f "$STATE"   # tells apps when compositing has settled
BOOT=$(cat /proc/sys/kernel/random/boot_id 2>/dev/null)
[ -f "$CONF" ] && [ -f "$SOFT" ] && [ -f "$LEGACY" ] || SUMMIT_APPEARANCE_LOCAL=1 summit-appearance write-files >/dev/null 2>&1
[ -f "$SOFT" ] || SOFT=/etc/xdg/picom-summit.conf
# keep the log small
[ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 200000 ] && tail -c 50000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
pkill -u "$(id -u)" -x picom 2>/dev/null; sleep 0.3
note() { echo "$(date '+%F %T') $*" >> "$LOG"; }
# the dock decides how to draw itself when it starts; after a gap in compositing it must start again
redock() {
  pgrep -u "$(id -u)" -x plank >/dev/null || return 0
  pkill -u "$(id -u)" -x plank
  # a new dock quits at once if the old one is still there, so wait until it has really gone
  for i in $(seq 1 40); do pgrep -u "$(id -u)" -x plank >/dev/null || break; sleep 0.25; done
  pkill -9 -u "$(id -u)" -x plank 2>/dev/null
  systemd-run --user --quiet --collect --scope -- setsid plank >/dev/null 2>&1 </dev/null &
  sleep 1
}

software() {
  echo software > "$STATE"
  # remember for this boot (glass becomes more solid so text stays readable)
  if [ "$(cat "$FLAG" 2>/dev/null)" != "$BOOT" ]; then
    echo "$BOOT" > "$FLAG"; (sleep 2; summit-appearance refresh-glass >/dev/null 2>&1) &
  fi
  note "software mode ($1)"
  [ -n "$TRIED$SUMMIT_REDOCK" ] && redock
  exec picom --config "$SOFT" --backend xrender 2>>"$LOG"
}

# start a GPU compositor and check it really draws; sets PID
gpu() {
  [ -n "$TRIED" ] && FELL=1; TRIED=1
  "$1" --config "$2" 2>>"$LOG" &
  PID=$!
  sleep 4
  if ! kill -0 "$PID" 2>/dev/null; then note "$3 didn't start"; return 1; fi
  if ! /usr/local/lib/summitos/screen-check >/dev/null 2>&1; then
    note "$3 started but drew a blank screen"; kill "$PID" 2>/dev/null; wait "$PID" 2>/dev/null; return 1
  fi
  return 0
}

[ -f "$FLAG.forced" ] && software "forced"
# GPU already failed during this boot: don't retry until the next restart
[ -n "$BOOT" ] && [ "$(cat "$FLAG" 2>/dev/null)" = "$BOOT" ] && software "GPU failed earlier this boot"

MODE=""
if [ -x "$PICOM12" ] && [ ! -f "$NO12" ] && gpu "$PICOM12" "$CONF" "picom 12"; then MODE=12
elif gpu picom "$LEGACY" "picom 10"; then
  MODE=10; [ -x "$PICOM12" ] && [ ! -f "$NO12" ] && echo "$BOOT" > "$NO12"   # picom 12 isn't usable here
else software "GPU compositor didn't work"
fi
note "GPU mode (picom $MODE)"
echo gpu > "$STATE"
[ -n "$FELL$SUMMIT_REDOCK" ] && redock
# blur works: if a previous boot fell back, give the glass back (only once it has proved stable)
if [ -f "$FLAG" ]; then
  ( sleep 60; kill -0 "$PID" 2>/dev/null && rm -f "$FLAG" && summit-appearance refresh-glass >/dev/null 2>&1 ) &
fi
wait "$PID"; rc=$?
case "$rc" in 0|137|143) exit 0 ;; esac     # stopped on purpose (restart, logout)
if [ "$MODE" = 12 ]; then
  note "picom 12 crashed (exit $rc): using picom 10"; echo "$BOOT" > "$NO12"; SUMMIT_REDOCK=1 exec "$0"
fi
software "GPU compositor crashed (exit $rc)"
