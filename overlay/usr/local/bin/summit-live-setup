#!/bin/sh
# Live session only: put the installer on the desktop and in the dock
grep -q "boot=casper" /proc/cmdline || exit 0
mkdir -p "$HOME/Desktop"
cp /usr/share/applications/summit-install.desktop "$HOME/Desktop/" 2>/dev/null
chmod +x "$HOME/Desktop/summit-install.desktop"
gio set "$HOME/Desktop/summit-install.desktop" metadata::xfce-exe-checksum "$(sha256sum "$HOME/Desktop/summit-install.desktop" | cut -d' ' -f1)" 2>/dev/null
