#!/usr/bin/python3
"""Summit App Store: find and install apps from Flathub.

Apps install for you only (no password needed) with Flatpak, each in its own sandbox, and show up in
Launchpad, Spotlight and the dock right away. The store only runs while its window is open.

  summit-appstore [--show APP_ID] [--updates]
"""
import os, sys, json, gzip, re, threading, subprocess, time, urllib.request, hashlib, warnings
import xml.etree.ElementTree as ET
os.environ.setdefault("NO_AT_BRIDGE", "1"); warnings.filterwarnings("ignore")
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("GdkPixbuf", "2.0")
from gi.repository import Gtk, Gdk, GLib, Gio, GdkPixbuf, Pango

HOME = os.path.expanduser("~")
FAKE = os.environ.get("SUMMIT_APPSTORE_FAKE")       # testing: a sample catalogue and simulated installs
REMOTE = "flathub"
REPO_URL = "https://dl.flathub.org/repo/flathub.flatpakrepo"
AS_DIR = os.path.join(HOME, ".local/share/flatpak/appstream", REMOTE, "x86_64", "active")
CACHE = os.path.join(HOME, ".cache", "summit-appstore"); os.makedirs(CACHE, exist_ok=True)
XML_LANG = "{http://www.w3.org/XML/1998/namespace}lang"

FEATURED = ["com.google.Chrome", "org.mozilla.firefox", "com.spotify.Client", "com.discordapp.Discord",
