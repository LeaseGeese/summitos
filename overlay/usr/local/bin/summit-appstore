            "com.brave.Browser", "com.microsoft.Edge", "org.kde.krita", "org.audacityteam.Audacity",
            "org.inkscape.Inkscape", "fr.handbrake.ghb", "org.keepassxc.KeePassXC", "com.calibre_ebook.calibre"]
POPULAR = set(FEATURED) | {"com.usebottles.bottles", "org.kde.kdenlive", "org.blender.Blender", "net.lutris.Lutris",
            "com.github.tchx84.Flatseal", "io.missioncenter.MissionCenter", "org.qbittorrent.qBittorrent",
            "com.github.johnfactotum.Foliate", "org.darktable.Darktable", "org.shotcut.Shotcut", "com.github.IsmaelMartinez.teams_for_linux"}
WINDOWS = ["com.usebottles.bottles", "net.lutris.Lutris", "com.heroicgameslauncher.hgl", "com.valvesoftware.Steam"]
SECTIONS = [  # (key, title, icon, freedesktop categories)
    ("discover", "Discover", "starred-symbolic", None),
    ("productivity", "Productivity", "x-office-document-symbolic", {"Office", "ProjectManagement", "Calendar", "WordProcessor", "Spreadsheet", "Presentation", "ContactManagement"}),
    ("internet", "Internet & Chat", "network-workgroup-symbolic", {"Network", "WebBrowser", "Chat", "InstantMessaging", "Email", "VideoConference", "FileTransfer", "P2P"}),
    ("media", "Music & Video", "folder-music-symbolic", {"AudioVideo", "Audio", "Video", "Music", "Player", "Recorder"}),
    ("graphics", "Graphics & Photo", "image-x-generic-symbolic", {"Graphics", "Photography", "2DGraphics", "3DGraphics", "RasterGraphics", "VectorGraphics"}),
