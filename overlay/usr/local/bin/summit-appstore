# ------------------------------------------------------------------ small things kept between runs
def load_state():
    try:
        with open(STATE) as f: d = json.load(f)
    except (OSError, ValueError): d = {}
    d.setdefault("apt", {}); d.setdefault("appimages", {}); d.setdefault("search_ubuntu", True)
    return d

def save_state(d):
    try:
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        with open(STATE + ".tmp", "w") as f: json.dump(d, f, indent=1)
        os.replace(STATE + ".tmp", STATE)
    except OSError: pass

def human(n):
    for unit in ("bytes", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB": return f"{n:.0f} {unit}" if unit in ("bytes", "KB") or n >= 100 else f"{n:.1f} {unit}"
        n /= 1000

def ago(ts):
    if not ts: return ""
    d = max(0, time.time() - ts) / 86400
    if d < 1: return "today"
    if d < 2: return "yesterday"
    if d < 31: return f"{int(d)} days ago"
    if d < 365: return f"{int(d / 30.4)} month{'s' if d >= 61 else ''} ago"
    return f"{int(d / 365)} year{'s' if d >= 730 else ''} ago"

# ------------------------------------------------------------------ Flathub (flatpak)
def flatpak(*args, timeout=600):
    try: return subprocess.run(["flatpak", *args], capture_output=True, text=True, timeout=timeout)
    except Exception as e:
        class R: returncode = 1; stdout = ""; stderr = str(e)
        return R()

def have_flatpak():
    return FAKE or bool(GLib.find_program_in_path("flatpak"))

def ensure_catalogue(force=False):
    """Add Flathub for this user and fetch its catalogue. Returns an error message or None."""
    if FAKE: return None
    if "flathub" not in flatpak("remotes", "--user", "--columns=name").stdout.split():
        r = flatpak("remote-add", "--user", "--if-not-exists", REMOTE, REPO_URL)
        if r.returncode != 0: return "Couldn't reach Flathub. Check your internet connection and try again."
    if force or not catalogue_file() or time.time() - os.path.getmtime(catalogue_file()) > 24 * 3600:
        r = flatpak("update", "--user", "--appstream", REMOTE)
        if r.returncode != 0 and not catalogue_file():
            return "Couldn't download the app catalogue. Check your internet connection and try again."
    return None

def catalogue_file():
    if FAKE: return FAKE
    for name in ("appstream.xml.gz", "appstream.xml"):
        p = os.path.join(AS_DIR, name)
        if os.path.exists(p): return p
    return None

def text_of(el):
    return re.sub(r"\s+", " ", "".join(el.itertext())).strip() if el is not None else ""

def paragraphs(desc):
    out = []
    if desc is not None:
        for c in desc:
            if c.tag == "p": out.append(text_of(c))
            elif c.tag in ("ul", "ol"): out.append("\n".join("•  " + text_of(li) for li in c.findall("li")))
    return "\n\n".join(p for p in out if p)

def parse_catalogue(path):
    """Flathub's AppStream catalogue -> compact list of apps (cached, so later opens are instant)."""
    st = os.stat(path); key = f"{path}:{st.st_mtime_ns}:{st.st_size}:5"
    cache = os.path.join(CACHE, "index.json")
    try:
        with open(cache) as f:
            d = json.load(f)
        if d.get("key") == key: return d["apps"]
    except (OSError, ValueError):
        pass
    apps = []
    opener = gzip.open if path.endswith(".gz") else open
    with opener(path, "rb") as f:
        for _, el in ET.iterparse(f, events=("end",)):
            if el.tag != "component": continue
            if el.get("type") in ("desktop", "desktop-application"):
                bundle = el.find("bundle")
                ref = bundle.text.strip() if bundle is not None and bundle.text else ""
                aid = ref.split("/")[1] if ref.count("/") >= 3 else (el.findtext("id") or "").removesuffix(".desktop")
                def plain(tag):
                    for c in el.findall(tag):
                        if c.get(XML_LANG) is None: return text_of(c)
                    return ""
                desc = next((d for d in el.findall("description") if d.get(XML_LANG) is None), None)
                icon = ""
                for ic in el.findall("icon"):
                    if ic.get("type") == "cached":
                        icon = ic.text.strip() if ic.text else ""
                        if ic.get("width") == "128": break
                shots = []
                for sc in el.iter("screenshot"):
                    imgs = sc.findall("image")
                    thumbs = sorted((int(i.get("width") or 0), i.text.strip()) for i in imgs if i.get("type") == "thumbnail" and i.text)
                    pick = [u for w, u in thumbs if 600 <= w <= 1300] or [u for w, u in thumbs] or [i.text.strip() for i in imgs if i.text]
                    if pick: shots.insert(0, pick[0]) if sc.get("type") == "default" else shots.append(pick[0])
                version = ""; updated = 0; news = ""
                rel = next(el.iter("release"), None)
                if rel is not None:
                    version = rel.get("version") or ""
                    try: updated = int(rel.get("timestamp") or 0)
                    except ValueError: updated = 0
                    if not updated and rel.get("date"):
                        try: updated = int(time.mktime(time.strptime(rel.get("date")[:10], "%Y-%m-%d")))
                        except ValueError: pass
                    news = paragraphs(next((d for d in rel.findall("description") if d.get(XML_LANG) is None), None))[:900]
                dev = el.find("developer")
                developer = (text_of(dev.find("name")) if dev is not None and dev.find("name") is not None else "") or plain("developer_name")
                custom = {v.get("key"): (v.text or "") for v in el.iter("value")}
                brand = {c.get("scheme_preference") or "light": (c.text or "").strip() for c in el.iter("color") if c.get("type") == "primary"}
                lic = el.findtext("project_license") or ""
                apps.append({
                    "id": aid, "name": plain("name") or aid, "summary": plain("summary"),
                    "desc": paragraphs(desc)[:4000], "icon": icon, "shots": shots[:6],
                    "dev": developer, "license": lic, "foss": bool(lic) and "proprietary" not in lic.lower(),
                    "cats": [c.text for c in el.iter("category") if c.text],
                    "kw": " ".join(k.text for k in el.iter("keyword") if k.text and k.get(XML_LANG) is None)[:300],
                    "verified": custom.get("flathub::verification::verified") == "true",
                    "urls": {u.get("type"): u.text for u in el.findall("url") if u.text and u.get("type") in ("homepage", "help", "donation", "bugtracker", "vcs-browser")},
                    "version": version, "updated": updated, "news": news, "brand": brand,
                })
            el.clear()
    try:
        with open(cache + ".tmp", "w") as f: json.dump({"key": key, "apps": apps}, f)
        os.replace(cache + ".tmp", cache)
    except OSError:
        pass
    return apps

_fake_installed = {"org.videolan.VLC": 412_000_000}
def installed_sizes():
    """Installed Flathub apps -> size in bytes."""
    if FAKE: return dict(_fake_installed)
    out = {}
    for line in flatpak("list", "--user", "--app", "--columns=application,size").stdout.splitlines():
        parts = line.split("\t") if "\t" in line else line.split(None, 1)
        if not parts or "." not in parts[0]: continue
        size = 0
        m = re.match(r"\s*([\d.,]+)\s*([kMGT]?)i?B", parts[1].replace("\xa0", " ")) if len(parts) > 1 else None
        if m:
            try: size = int(float(m.group(1).replace(",", ".")) * {"": 1, "k": 1e3, "M": 1e6, "G": 1e9, "T": 1e12}[m.group(2)])
            except ValueError: size = 0
        out[parts[0].strip()] = size
    for line in flatpak("list", "--app", "--columns=application").stdout.splitlines():      # system-wide ones too
        if "." in line: out.setdefault(line.strip(), 0)
    return out

def update_ids():
    if FAKE: return {"org.videolan.VLC"} & set(_fake_installed)
    out = flatpak("remote-ls", "--user", "--updates", "--app", "--columns=application", REMOTE).stdout
    return {l.strip() for l in out.splitlines() if l.strip() and "." in l}

_size_cache = {}
def download_size(aid):
    """(download, installed) sizes as text, asked from Flathub (slow: call from a thread)."""
    if aid in _size_cache: return _size_cache[aid]
    if FAKE: res = ("95 MB", "280 MB")
    else:
        out = flatpak("remote-info", "--user", REMOTE, aid, timeout=40).stdout
        g = lambda k: (re.search(rf"^\s*{k}:\s*(.+)$", out, re.M) or [None, ""])[1].replace("\xa0", " ").strip()
        res = (g("Download"), g("Installed"))
    _size_cache[aid] = res
    return res

def run_job(cmd, on_line, fake=None):
    """Run an install/remove/update command, reporting progress lines. Returns (ok, last line)."""
    if FAKE:
        for i in range(6): time.sleep(0.4); on_line(f"Downloading… {i * 20}%")
        if fake: fake()
        return True, ""
    try:
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
    except OSError as e:
        return False, str(e)
    last = ""
    for line in iter(p.stdout.readline, ""):
        for part in line.replace("\r", "\n").splitlines():
            part = part.strip()
            if part: last = part; on_line(part)
    p.wait()
    if p.returncode in (126, 127) and cmd[0] == "pkexec": return False, "cancelled"
    return p.returncode == 0, last

def flatpak_launcher(aid):
    """The launcher Flatpak exports for an installed app (the same one Launchpad uses)."""
    for base in (os.path.join(GLib.get_user_data_dir(), "flatpak"), "/var/lib/flatpak"):
        path = os.path.join(base, "exports", "share", "applications", aid + ".desktop")
        if os.path.exists(path):
            try: return Gio.DesktopAppInfo.new_from_filename(path)
            except Exception: pass
    return None

def launch(a):
    """Open an installed app. Returns (process or None, error text); a process is checked a moment later."""
    if FAKE: return None, ""
    try:
        if a.get("apt"):
            desk = apt_launcher(a["apt"])
            info = Gio.DesktopAppInfo.new(desk) if desk else None
            if info is None: return None, "This app has no launcher of its own."
            info.launch([], None); return None, ""
        if a.get("appimage"):
            cmd = [a["appimage"]]
        else:
            info = flatpak_launcher(a["id"])
            if info is not None:
                info.launch([], None); return None, ""
            cmd = ["flatpak", "run", a["id"]]
        os.makedirs(CACHE, exist_ok=True)
        with open(os.path.join(CACHE, "open.log"), "w") as log:
            return subprocess.Popen(cmd, start_new_session=True, stdin=subprocess.DEVNULL, stdout=log, stderr=log), ""
    except Exception as e:
        return None, getattr(e, "message", None) or str(e)

# ------------------------------------------------------------------ Ubuntu's library (apt)
APT_SKIP = re.compile(r"^(lib|python3?-|fonts-|ruby-|node-|golang-|r-cran-|php|perl|texlive|linux-|gir1\.2|language-|firmware-|.*-(dev|dbg|dbgsym|doc|data|common|l10n|locale|plugins?|examples|tests?|headers|source|bin)$)")
def apt_installed(pkg):
    r = subprocess.run(["dpkg-query", "-W", "-f=${db:Status-Status}", pkg], capture_output=True, text=True)
    return r.stdout.strip() == "installed"

_launcher_cache = {}
def apt_launcher(pkg):
    """The app's launcher (.desktop file name) if the package has one."""
    if pkg not in _launcher_cache:
        out = subprocess.run(["dpkg", "-L", pkg], capture_output=True, text=True).stdout
        m = re.search(r"^/usr/share/applications/(.+\.desktop)$", out, re.M)
        _launcher_cache[pkg] = m.group(1) if m else ""
    return _launcher_cache[pkg]

def apt_search(q, limit=9):
    """Apps (not libraries or parts of other packages) in Ubuntu's library whose name matches."""
    words = [w for w in re.split(r"[^a-z0-9+.]+", q.lower()) if w]
    if not words or len(q) < 3: return []
    try: out = subprocess.run(["apt-cache", "search", "--names-only", "--", *words], capture_output=True, text=True, timeout=8).stdout
    except Exception: return []
    found = []
    for line in out.splitlines():
        pkg, _, desc = line.partition(" - ")
        if not desc or APT_SKIP.match(pkg): continue
        score = 0 if pkg == q.lower() else 1 if pkg.startswith(words[0]) else 2
        found.append((score, len(pkg), pkg, desc))
    return [apt_app(pkg, desc) for _, _, pkg, desc in sorted(found)[:limit]]

def apt_app(pkg, summary=""):
    return {"id": "apt:" + pkg, "apt": pkg, "name": pkg.replace("-", " ").title() if len(pkg) > 4 else pkg, "summary": summary[:1].upper() + summary[1:],
            "desc": "", "icon": "", "shots": [], "dev": "", "license": "", "foss": True, "cats": [], "kw": "", "verified": False, "urls": {},
            "version": "", "updated": 0, "news": "", "brand": {}}

def apt_details(pkg):
    """Long description, version, homepage and download size from the package record."""
    out = subprocess.run(["apt-cache", "show", "--no-all-versions", pkg], capture_output=True, text=True).stdout
    g = lambda k: (re.search(rf"^{k}: (.+)$", out, re.M) or [None, ""])[1]
    m = re.search(r"^Description(?:-en)?: .*\n((?: .*\n?)+)", out, re.M)
    long = "\n".join(l[1:] for l in m.group(1).splitlines()) if m else ""
    long = re.sub(r"\n\.\n", "\n\n", long); long = re.sub(r"(?<!\n)\n(?![\n \-*])", " ", long)
    try: size = human(int(g("Size")))
    except ValueError: size = ""
    return {"desc": long.strip(), "version": g("Version").split(":")[-1].split("-")[0], "home": g("Homepage"), "size": size}

# ------------------------------------------------------------------ icons and pictures
_icon_cache = {}
def app_icon(app, size):
    k = (app["id"], size)
    if k in _icon_cache: return _icon_cache[k]
    pb = None
    for d in ("128x128", "64x64"):
        p = os.path.join(os.path.dirname(catalogue_file() or "") if FAKE else AS_DIR, "icons", d, app.get("icon") or "")
        if app.get("icon") and os.path.exists(p):
            try: pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, size, size, True); break
            except GLib.Error: pass
    if pb is None:
        theme = Gtk.IconTheme.get_default()
        names = ([app["apt"]] if app.get("apt") else []) + (["application-x-executable"] if not app.get("apt") else ["package-x-generic", "application-x-executable"])
        for name in names:
            if theme.has_icon(name):
                try: pb = theme.load_icon(name, size, Gtk.IconLookupFlags.FORCE_SIZE); break
                except GLib.Error: pass
    _icon_cache[k] = pb
    return pb

def load_picture(url, width, height, done):
    """Fetch a screenshot in the background (cached on disk) and hand back an image that fits width x height."""
    def work():
        path = os.path.join(CACHE, "shots", hashlib.sha1(url.encode()).hexdigest()[:20])
        try:
            if not os.path.exists(path):
                os.makedirs(os.path.dirname(path), exist_ok=True)
                req = urllib.request.Request(url, headers={"User-Agent": "SummitAppStore/1.0"})
                with urllib.request.urlopen(req, timeout=20) as r, open(path + ".tmp", "wb") as f: f.write(r.read(8 * 1024 * 1024))
                os.replace(path + ".tmp", path)
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, width, height, True)
            GLib.idle_add(done, pb)
        except Exception:
            GLib.idle_add(done, None)
    threading.Thread(target=work, daemon=True).start()

def label(text, cls=None, xalign=0.0, wrap=False, lines=0, sel=False):
    l = Gtk.Label(label=text, xalign=xalign)
    if wrap: l.set_line_wrap(True); l.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
    if lines: l.set_lines(lines); l.set_ellipsize(Pango.EllipsizeMode.END)
    if sel: l.set_selectable(True)
    for c in (cls.split() if cls else []): l.get_style_context().add_class(c)
    return l

def style(widget, css):
    """Give one widget its own bit of CSS (gradients and tints that differ per app or category)."""
    p = Gtk.CssProvider(); p.load_from_data(css.encode())
    widget.get_style_context().add_provider(p, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION + 1)

def gradient(colors, angle=120):
    return f"background-image: linear-gradient({angle}deg, {', '.join(colors)});"

CSS = b"""
