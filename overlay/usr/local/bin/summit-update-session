#!/bin/bash
# Runs inside your desktop session when Summit installs an update (or one becomes available):
# applies per-user changes, refreshes only the parts of the desktop the update touched,
# and tells you what changed.
D=/var/lib/summit-update
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}" XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-XFCE}"   # the dock checks these
SEEN="$HOME/.config/summit/update-seen"
mkdir -p "$HOME/.config/summit"
# one run at a time: a second trigger waits, then finds the update already handled
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/summit-update-session.lock"; flock -w 60 9 || true

jget() { python3 - "$1" "$2" <<'PY' 2>/dev/null
import json, sys
d = json.load(open(sys.argv[1])); v = d.get(sys.argv[2], "")
print("\n".join("• " + x for x in v[:4]) if isinstance(v, list) else v)
PY
}
touched() {   # did the update change any file matching one of these patterns?
  python3 - "$D/state.json" "$@" <<'PY'
import json, sys, fnmatch
files = json.load(open(sys.argv[1])).get("changed_files", [])
sys.exit(0 if any(fnmatch.fnmatch(f, p) for f in files for p in sys.argv[2:]) else 1)
PY
}
launch() {    # start a desktop part as its own app: outside this job, without our lock
  systemd-run --user --quiet --collect --scope -- setsid "$@" >/dev/null 2>&1 < /dev/null 9>&- &
}
restart() {   # stop a desktop part, wait until it's really gone, start it again
  pkill -u "$(id -u)" "${@:2}" "$1"
  for i in $(seq 1 25); do pgrep -u "$(id -u)" "${@:2}" "$1" >/dev/null || break; sleep 0.2; done
}

# 1) an update is waiting (automatic install is off)
if [ -f "$D/available.json" ]; then
  key="avail-$(jget $D/available.json sha)$(jget $D/available.json build)"
  if ! grep -qx "$key" "$SEEN" 2>/dev/null; then
    echo "$key" >> "$SEEN"
    ver=$(jget $D/available.json version)
    ( exec 9>&-; act=$(notify-send -a "Software Update" -i summit-update -A install="Install Now" -A later="Later" \
              "Summit OS $ver is available" "$(jget $D/available.json notes)")
      [ "$act" = install ] && systemctl start --no-block summit-update-install.service ) &
  fi
fi

# 2) an update was installed (or rolled back)
[ -f "$D/state.json" ] || exit 0
key="inst-$(jget $D/state.json sha)$(jget $D/state.json build)-$(jget $D/state.json installed_at)"
grep -qx "$key" "$SEEN" 2>/dev/null && exit 0
echo "$key" >> "$SEEN"

[ -f "$D/current/user.sh" ] && bash "$D/current/user.sh" >/dev/null 2>&1

if [ "$1" != "--login" ] && [ -n "$DISPLAY" ]; then
  if touched 'usr/local/bin/summit-appearance' 'usr/share/themes/*' 'usr/share/icons/*' 'etc/xdg/picom*' 'usr/local/bin/summit-compositor'; then
    summit-appearance apply >/dev/null 2>&1 9>&-                              # styles, colours, compositor
  fi
  # the desktop's own parts are restarted through their keepers (summit-keep), which also start any that are missing
  COMP=""
  if touched 'usr/local/bin/summit-compositor' 'usr/local/lib/summitos/picom' 'usr/local/lib/summitos/screen-check'; then
    COMP=1; rm -f "$HOME/.config/summit/no-picom12"     # a new compositor gets a fresh chance at the animations
    rm -f "${XDG_RUNTIME_DIR:-/tmp}/summit-compositor-$(id -u)" "${XDG_RUNTIME_DIR:-/tmp}/summit-compositor-ok-$(id -u)"
  fi
  if touched 'usr/local/bin/summit-keep'; then
    summit-keep --reload 9>&-                           # new keepers, which start every part afresh
  else
    if [ -n "$COMP" ]; then
      summit-keep --restart compositor 9>&-             # new compositor (and its animations) right away
      # the dock only draws properly if compositing is up when it starts: wait for the compositor, then restart it
      for i in $(seq 1 60); do [ -s "${XDG_RUNTIME_DIR:-/tmp}/summit-compositor-$(id -u)" ] && break; sleep 0.25; done
      summit-keep --restart dock 9>&-
    fi
    touched 'usr/local/bin/summit-gestures' && summit-keep --restart gestures 9>&-             # mouse/trackpad gestures
    touched 'usr/local/lib/summitos/summit-wm-helper' && summit-keep --restart wm 9>&-          # full-screen green button
    if touched 'usr/local/bin/summit-shell*' 'usr/local/bin/summit-control-center' 'usr/local/bin/summit-appearance' 'usr/local/bin/summit-transition' 'usr/local/lib/summitos/summit_look.py' 'usr/share/icons/*' 'usr/share/applications/*'; then
      summit-keep --restart shell 9>&-                  # Spotlight, Launchpad, Control Center
    fi
    if [ -z "$COMP" ] && touched 'usr/share/plank/*' 'usr/share/icons/*' 'usr/share/applications/*' 'usr/share/summitos/icons/*'; then
      summit-keep --restart dock 9>&-                   # dock
    fi
  fi
  if touched 'usr/local/bin/summit-airplay' 'usr/local/bin/summit-connect-agent' && [ -f "$HOME/.config/autostart/summit-airplay.desktop" ]; then
    summit-connect-agent stop-airplay; launch summit-connect-agent airplay   # new AirPlay receiver (also clears a stuck picture)
  fi
  if touched 'usr/local/bin/summit-connect-agent' && [ -f "$HOME/.config/autostart/summit-screen-sharing.desktop" ]; then
    summit-connect-agent stop-screen; launch summit-connect-agent screen        # Screen Sharing with the new settings
  fi
  if touched 'etc/xdg/xfce4/panel/*' 'usr/share/xfce4/panel/*' 'usr/lib/x86_64-linux-gnu/xfce4/panel/*' 'usr/lib/x86_64-linux-gnu/gtk-3.0/modules/*'; then
    xfce4-panel -r >/dev/null 2>&1 9>&- &                                                  # menu bar
  fi
  # self-heal: every part of the desktop should be running, each under its keeper
  sleep 2
  pgrep -u "$(id -u)" -f notifyd/xfce4-notifyd >/dev/null || launch /usr/lib/x86_64-linux-gnu/xfce4/notifyd/xfce4-notifyd
  summit-keep --ensure 9>&-
fi

ver=$(jget $D/state.json version); notes=$(jget $D/state.json notes)
if [ "$(jget $D/state.json restart)" = reboot ]; then
  ( exec 9>&-; act=$(notify-send -a "Software Update" -i summit-update -u critical -A restart="Restart Now" -A later="Later" \
            "Summit OS $ver installed" "Restart to finish updating.${notes:+$'\n'$notes}")
    [ "$act" = restart ] && xfce4-session-logout --reboot ) &
else
  # wait until the notification service is back (it may restart with the desktop), then show what changed
  for i in $(seq 1 20); do
    gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications \
      --method org.freedesktop.Notifications.GetServerInformation >/dev/null 2>&1 && break; sleep 0.5
  done
  notify-send -a "Software Update" -i summit-update "Summit OS updated to $ver" "${notes:-Your desktop was refreshed with the latest changes.}"
fi
tail -n 50 "$SEEN" > "$SEEN.tmp" 2>/dev/null && mv "$SEEN.tmp" "$SEEN"
