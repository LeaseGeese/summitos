#!/bin/sh
# Instantly open Spotlight / Launchpad / Control Center in the running summit-shell.
ACTION="${1:-spotlight}"
gdbus call --session --dest org.summitos.Shell --object-path /org/summitos/Shell \
  --method org.gtk.Actions.Activate "$ACTION" "[]" "{}" >/dev/null 2>&1 && exit 0
# not running yet: start it (it performs the action once it's up)
exec summit-shell --"$ACTION"
