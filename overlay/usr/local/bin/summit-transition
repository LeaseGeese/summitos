#!/usr/bin/python3
"""summit-transition: a smooth crossfade for appearance changes (light/dark, accent, wallpaper, text size).

Takes a snapshot of the screen and shows it on top of everything, so the dock, menu bar, windows and
wallpaper can all switch underneath without anyone seeing them change one by one. Then it fades the
snapshot away. Clicks pass straight through it.

summit-shell uses the Crossfade class directly (no extra process, so it starts instantly). As a command:

  summit-transition [--expect panel,dock,desktop]

prints "ready" once the snapshot is on screen, then waits for a line on stdin (or end of input).
Either way it then watches the menu bar, dock and desktop windows underneath and fades out once the
ones listed in `expect` have repainted and nothing has changed for a moment, and never holds the
screen longer than a few seconds.
"""
import os, sys, threading, time, warnings, subprocess, zlib
os.environ.setdefault("NO_AT_BRIDGE", "1")
warnings.filterwarnings("ignore")
import gi
gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0"); gi.require_version("GdkX11", "3.0")
from gi.repository import Gtk, Gdk, GLib, GdkX11
import cairo

MIN_HOLD_MS = int(os.environ.get("SUMMIT_TRANSITION_HOLD", "120"))
MAX_HOLD_MS = int(os.environ.get("SUMMIT_TRANSITION_MAX", "2500"))   # never freeze the screen longer than this
STABLE_MS = int(os.environ.get("SUMMIT_TRANSITION_STABLE", "250"))   # settled once nothing changed for this long
FADE_MS = int(os.environ.get("SUMMIT_TRANSITION_FADE", "260"))
POLL_MS = 60
LOG = os.environ.get("SUMMIT_TRANSITION_LOG")       # for testing: when each phase happened
CLASSES = {"panel": "xfce4-panel.Xfce4-panel", "dock": "plank.Plank", "desktop": "xfdesktop.Xfdesktop"}

def log(what):
    if LOG:
        with open(LOG, "a") as f: f.write(f"{time.time():.3f} {what}\n")

def find_windows():
    """X window ids of the menu bar, dock and desktop (managed windows, by class)."""
    found = {}
    try:
        out = subprocess.run(["wmctrl", "-lx"], capture_output=True, text=True, timeout=2).stdout
    except Exception:
        return found
    for line in out.splitlines():
        parts = line.split(None, 3)
        if len(parts) < 3: continue
        for name, cls in CLASSES.items():
            if parts[2] == cls and name not in found:
                found[name] = int(parts[0], 16)
    return found

class Watch:
    """Fingerprints of what the menu bar, dock and desktop windows show. Each window is read on its own
    (not through the screen), so the snapshot on top doesn't get in the way."""
    def __init__(self, display, names):
        self.display = display; self.names = set(names); self.wins = {}; self.xids = {}
        self.refresh()
        self.first = self.sample(); self.last = dict(self.first); self.changed_at = time.monotonic()

    def refresh(self):
        if not self.names: return
        for name, xid in find_windows().items():
            if name not in self.names or self.xids.get(name) == xid: continue
            try:
                self.wins[name] = GdkX11.X11Window.foreign_new_for_display(self.display, xid); self.xids[name] = xid
            except Exception:
                pass

    def sample(self):
        sig = {}
        for name, w in list(self.wins.items()):
            try:
                x, y, ww, hh = w.get_geometry()
                if name == "desktop":           # the wallpaper changes everywhere at once: a small patch is enough
                    x, y, ww, hh = ww // 2 - 160, hh // 2 - 90, 320, 180
                else:
                    x, y = 0, 0
                pb = Gdk.pixbuf_get_from_window(w, x, y, ww, hh)
                sig[name] = (self.xids[name], zlib.crc32(pb.read_pixel_bytes().get_data())) if pb else None
            except Exception:
                sig[name] = None
        return sig

    def poll(self, refresh=False):
        if refresh: self.refresh()              # a restarted menu bar comes back as a new window
        now = self.sample()
        if now != self.last: self.changed_at = time.monotonic(); self.last = now

    def repainted(self, name):
        return name not in self.wins or self.last.get(name) != self.first.get(name)

    def stable_ms(self):
        return (time.monotonic() - self.changed_at) * 1000

class Crossfade:
    """Freeze the screen under a snapshot; call go() once the change has been applied.
    on_ready() runs when the snapshot is on screen, on_done() when it has faded away."""
    def __init__(self, expect=(), on_ready=None, on_done=None):
        self.expect = [e for e in expect if e in CLASSES]
        self.on_ready, self.on_done = on_ready, on_done
        self.state = "new"; self.win = None
        display = Gdk.Display.get_default()
        root = Gdk.get_default_root_window()
        w, h = root.get_width(), root.get_height()
        self.watch = Watch(display, CLASSES)
        shot = Gdk.pixbuf_get_from_window(root, 0, 0, w, h)
        if shot is None:
            self.state = "failed"; GLib.idle_add(self._ready); return
        win = Gtk.Window(type=Gtk.WindowType.POPUP)
        win.set_title("Summit transition"); win.set_wmclass("summit-transition", "Summit-transition")
        win.set_app_paintable(True); win.set_decorated(False); win.set_accept_focus(False)
        win.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        visual = win.get_screen().get_rgba_visual()
        if visual is not None: win.set_visual(visual)
        win.move(0, 0); win.set_default_size(w, h); win.resize(w, h)
        def draw(_w, cr):
            Gdk.cairo_set_source_pixbuf(cr, shot, 0, 0); cr.set_operator(cairo.OPERATOR_SOURCE); cr.paint()
            return True
        win.connect("draw", draw)
        def on_map(*_):
            win.input_shape_combine_region(cairo.Region())     # clicks go to whatever is underneath
            GLib.timeout_add(40, self._ready)                  # let the compositor put the frame on screen
        win.connect("map-event", on_map)
        self.win = win; self.state = "showing"
        GLib.timeout_add(1500, self._ready)                   # never wait forever for the map
        win.show_all()

    def _ready(self):
        if self.state in ("showing", "failed"):
            failed = self.state == "failed"
            self.state = "ready"; log("ready")
            if self.on_ready: self.on_ready()
            if failed: self._finish()
        return False

    def go(self):
        """The change has been applied: wait for it to show, then fade."""
        if self.state != "ready": return
        self.state = "settling"; log("go"); self.since = time.monotonic(); self.polls = 0
        GLib.timeout_add(POLL_MS, self._settle)

    def _settle(self):
        held = (time.monotonic() - self.since) * 1000
        self.polls += 1
        self.watch.poll(refresh=self.polls % 5 == 0)
        done = all(self.watch.repainted(e) for e in self.expect) and self.watch.stable_ms() >= STABLE_MS
        if (held >= MIN_HOLD_MS and done) or held >= MAX_HOLD_MS:
            log("settled" if done else "timeout")
            self.state = "fading"; self.t0 = time.monotonic(); log("fade")
            GLib.timeout_add(16, self._fade)
            return False
        return True

    def _fade(self):
        t = (time.monotonic() - self.t0) * 1000 / max(FADE_MS, 1)
        if t >= 1:
            self._finish(); return False
        e = 1 - (1 - t) ** 3                    # ease out
        self.win.set_opacity(max(0.0, 1 - e))
        return True

    def _finish(self):
        log("done"); self.state = "done"
        if self.win is not None: self.win.destroy(); self.win = None
        if self.on_done: self.on_done()

def main(argv):
    expect = []
    if "--expect" in argv:
        i = argv.index("--expect")
        if i + 1 < len(argv): expect = argv[i + 1].split(",")
    Gdk.set_program_class("Summit-transition")
    cf = Crossfade(expect, on_ready=lambda: print("ready", flush=True), on_done=Gtk.main_quit)
    def wait_stdin():
        try: sys.stdin.readline()
        except Exception: pass
        GLib.idle_add(lambda: (cf.go(), False)[1])
    threading.Thread(target=wait_stdin, daemon=True).start()
    GLib.timeout_add_seconds(10, lambda: (cf.go(), False)[1])
    Gtk.main()
    return 0

if __name__ == "__main__":
    sys.exit(main(sys.argv))
