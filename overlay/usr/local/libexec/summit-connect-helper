#!/bin/bash
# Summit Connect privileged helper (run through pkexec). Only does a fixed set of actions.
set -euo pipefail
ACTION="${1:-}"
CALLER="$(id -nu "${PKEXEC_UID:-0}")"
[ "$CALLER" != "root" ] || { echo "must be called via pkexec" >&2; exit 1; }
HOST="$(hostname)"

write_smb_conf() {
  local tm_size="$1"
  cat > /etc/samba/smb.conf <<CONF
# Generated by Summit Connect. Turn File Sharing off and on again to regenerate.
[global]
   workgroup = WORKGROUP
   server string = Summit iMac
   server role = standalone server
   server min protocol = SMB2_10
   disable netbios = yes
   smb ports = 445
   multicast dns register = yes
   security = user
   map to guest = never
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   log level = 0
   max log size = 256
   vfs objects = catia fruit streams_xattr
   fruit:metadata = stream
   fruit:model = iMac14,4
   fruit:posix_rename = yes
   fruit:veto_appledouble = no
   fruit:nfs_aces = no
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes

[homes]
   comment = Home folder
   browseable = no
   read only = no
   valid users = %S
   create mask = 0644
   directory mask = 0755
CONF
  if [ "$tm_size" -gt 0 ]; then
    TMPATH=/srv/timemachine
    mountpoint -q /mnt/imac-hd && TMPATH=/mnt/imac-hd/TimeMachine
    install -d -o "$CALLER" -g "$CALLER" -m 0700 "$TMPATH"
    cat >> /etc/samba/smb.conf <<CONF

[Time Machine]
   comment = Time Machine backups
   path = $TMPATH
   valid users = $CALLER
   read only = no
   fruit:time machine = yes
   fruit:time machine max size = ${tm_size}G
CONF
  fi
  testparm -s /etc/samba/smb.conf >/dev/null 2>&1
}

case "$ACTION" in
  files-on)
    TM="${2:-0}"; [[ "$TM" =~ ^[0-9]+$ ]] || TM=0
    IFS= read -r PW || true
    [ -n "$PW" ] || { echo "password required" >&2; exit 2; }
    [ -f /etc/samba/smb.conf.summit-orig ] || cp /etc/samba/smb.conf /etc/samba/smb.conf.summit-orig 2>/dev/null || true
    write_smb_conf "$TM"
    printf '%s\n%s\n' "$PW" "$PW" | smbpasswd -a -s "$CALLER" >/dev/null
    smbpasswd -e "$CALLER" >/dev/null
    systemctl enable --now smbd >/dev/null 2>&1
    systemctl restart smbd ;;
  files-off)
    systemctl disable --now smbd >/dev/null 2>&1 || true ;;
  ssh-on)
    install -m 0644 /usr/share/summitos/avahi/ssh.service /usr/share/summitos/avahi/sftp-ssh.service /etc/avahi/services/
    systemctl enable --now ssh >/dev/null 2>&1 ;;
  ssh-off)
    rm -f /etc/avahi/services/ssh.service /etc/avahi/services/sftp-ssh.service
    systemctl disable --now ssh ssh.socket >/dev/null 2>&1 || true ;;
  *) echo "unknown action" >&2; exit 64 ;;
esac
