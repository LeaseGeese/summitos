#!/bin/sh
# Summit OS: keep the drive's generic boot folder (EFI/BOOT) a complete, working copy of the boot loader.
# Macs start external and internal Linux drives through EFI/BOOT/BOOTX64.EFI (Option key -> "EFI Boot"),
# and Apple firmware does not keep the boot entries other computers rely on. Runs after installs and updates.
ESP=/boot/efi
[ -d "$ESP/EFI" ] || exit 0
SRC="$ESP/EFI/summitos"
[ -f "$SRC/grubx64.efi" ] || exit 0
mkdir -p "$ESP/EFI/BOOT"
put() { [ -f "$1" ] || return 0; cmp -s "$1" "$2" 2>/dev/null || cp "$1" "$2"; }
if [ -f "$SRC/shimx64.efi" ]; then            # Secure Boot chain: shim starts the boot loader next to it
  put "$SRC/shimx64.efi" "$ESP/EFI/BOOT/BOOTX64.EFI"
  put "$SRC/grubx64.efi" "$ESP/EFI/BOOT/grubx64.efi"
  put "$SRC/mmx64.efi"   "$ESP/EFI/BOOT/mmx64.efi"
  put "$SRC/grub.cfg"    "$ESP/EFI/BOOT/grub.cfg"
else                                           # plain boot loader: it finds the system drive by itself
  put "$SRC/grubx64.efi" "$ESP/EFI/BOOT/BOOTX64.EFI"
fi
rm -f "$ESP/EFI/BOOT/fbx64.efi"
exit 0
