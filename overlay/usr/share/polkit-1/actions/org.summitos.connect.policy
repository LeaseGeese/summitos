<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Summit OS</vendor>
  <action id="org.summitos.connect.helper">
    <description>Change sharing settings</description>
    <message>Summit Connect needs your password to change sharing settings.</message>
    <icon_name>summit-connect</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/libexec/summit-connect-helper</annotate>
  </action>
</policyconfig>
