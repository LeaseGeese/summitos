// Summit OS: people in the "sudo" group, sitting at the computer, can check for and
// install Summit updates from Settings without typing a password.
polkit.addRule(function(action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        ["summit-update-now.service", "summit-update-install.service"].indexOf(action.lookup("unit")) >= 0 &&
        action.lookup("verb") == "start" &&
        subject.local && subject.active && subject.isInGroup("sudo")) {
        return polkit.Result.YES;
    }
});
