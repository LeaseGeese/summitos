[Unit]
Description=Summit OS performance tuning
After=systemd-modules-load.service systemd-udev-settle.service local-fs.target
# disk settings must be right before the app preloader decides whether to run
Before=preload.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/summit-tune

[Install]
WantedBy=multi-user.target
